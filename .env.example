# 模型层配置（厂商无关，任意 OpenAI 兼容服务均可）
# 三项必填：未配置时应用仍可启动，/health 返回 llm_configured=false，生成接口返回 LLM_NOT_CONFIGURED
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# 嵌入配置：local 为默认（CPU 可跑，需可选依赖 maitian-agent[rag]）
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 当 EMBEDDING_BACKEND=openai_compatible 时可选；未设置则回退到对应的 LLM_*
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 语音识别（ASR，OpenAI 兼容接口）—— 三项均无厂商默认值；未配置时 ASR 不可用
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=

# OCR 后端：none（默认，不加载 torch/easyocr）| easyocr | xiaomi
OCR_BACKEND=none

# 本地上传目录；Compose 固定覆盖为 /app/data/uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173
# 本地前端；Compose 覆盖为 http://api:8000
MAITIAN_API_BASE=http://localhost:8000
